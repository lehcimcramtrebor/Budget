{
  "name": "budgethmr",
  "version": "4.0.0",
  "description": "Suivi de budget mensuel simple, rapide et gratuit",
  "main": "index.html",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/assets/css/output.css --minify",
    "build": "node build.js",
    "cap-sync": "npx cap sync",
    "build-apk": "npm run build && npx cap sync && cd android && cmd /c \"set JAVA_HOME=C:\\\\Program Files\\\\Android\\\\Android Studio\\\\jbr&& gradlew.bat assembleDebug\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capgo/capacitor-navigation-bar": "^6.1.75"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "sharp": "^0.33.2",
    "tailwindcss": "^3.4.19"
  }
}
